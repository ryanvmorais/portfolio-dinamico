# 🔐 PROJETO: CONFIGURAÇÃO DE AMBIENTE (.ENV.EXAMPLE)
# 🎯 Objetivo: Modelo de variáveis necessárias para rodar o projeto.
# ⚠️ INSTRUÇÃO: Copie este arquivo, renomeie para apenas ".env" e preencha os valores.
# 🛑 NUNCA compartilhe o seu arquivo ".env" final no GitHub.

# --- 1. SEGURANÇA DO DJANGO ---
# Gere uma chave aleatória para proteger a sessão e os dados do seu site.
SECRET_KEY=sua-chave-secreta-aqui

# Mantenha True para testar no seu computador e False para colocar na internet.
DEBUG=True

# --- 2. CONFIGURAÇÃO DE ACESSO ---
# Em desenvolvimento, use '*'. Em produção, use seu domínio (ex: seu-dominio.com.br).
# IMPORTANTE: No .env, não use colchetes ou aspas, apenas os valores separados por vírgula
# (espaços depois da vírgula e uma vírgula sobrando no fim são aceitos).
ALLOWED_HOSTS=*,127.0.0.1,localhost

# URL personalizada para o painel administrativo (ex: painel-secreto/)
ADMIN_URL=admin/

# Pasta do banco (db.sqlite3), da mídia enviada pelo Admin (media/) e do cache do
# rate limit (django_cache/). Padrão: a raiz do projeto. Num deploy em contêiner,
# aponte para o volume persistente (ex: /data), senão os três somem a cada deploy.
# Caminho relativo parte da raiz do projeto.
# DIRETORIO_DADOS=/data

# Endereço público do site, só esquema e domínio (ex: https://seu-dominio.com.br).
# Liga o canonical, o og:url, o /sitemap.xml e a linha Sitemap: do /robots.txt, e
# é a base do endereço absoluto das imagens do cartão. Vazia: sem canonical e sem
# sitemap. Valor com caminho, query ou sem https:// impede o servidor de subir.
# URL_PUBLICA=https://seu-dominio.com.br

# --- 3. COMUNICAÇÃO (SMTP / GMAIL) ---
# O e-mail que enviará as mensagens do formulário de contato.
# Sem conta Gmail? Com DEBUG=True, deixe EMAIL_USER vazio (EMAIL_USER=): o e-mail
# que sairia aparece impresso no terminal do runserver. Em produção, vazio faz o
# envio falhar e o visitante ver o aviso de erro.
EMAIL_USER=seu-email@gmail.com

# Não é a sua senha comum! Use uma "Senha de App" gerada na sua conta Google.
EMAIL_PASS=sua-senha-de-app-de-16-digitos

# Modo demonstração do formulário de contato (padrão: False).
# True: o formulário valida os campos, mas não grava a mensagem nem envia o
# e-mail, e avisa o visitante que é uma demonstração. Use numa demo pública.
# Também troca o título, a description e a imagem do cartão das redes sociais
# pelos da demonstração do template, e publica o /.well-known/security.txt com o
# contato de segurança do repositório do template.
# False (ou ausente): fluxo completo, com gravação no banco e envio por SMTP.
MODO_DEMONSTRACAO=False
