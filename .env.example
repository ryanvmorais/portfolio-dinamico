# 🔐 CONFIGURAÇÃO DE AMBIENTE (.env.example)
# 🎯 Para que serve: lista as variáveis que o projeto lê do ambiente, com o que
#    cada uma faz. Valores de verdade (principalmente os segredos) ficam fora do
#    código, num arquivo .env que só existe no seu computador ou no servidor.
# ⚠️ Como usar: copie este arquivo para ".env" e preencha. Para rodar no seu
#    computador, basta gerar a SECRET_KEY: os outros valores abaixo já servem
#    para o desenvolvimento.
# 🛑 O ".env" nunca vai para o GitHub (o .gitignore o bloqueia). Este modelo vai,
#    por isso aqui só há valores vazios ou de exemplo.

# --- 1. SEGURANÇA DO DJANGO ---

# Chave que assina as sessões, os cookies e o token CSRF. Segredo: quem a tem
# consegue forjar uma sessão de login. Gere uma com:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Vazia: o servidor não sobe, nem em desenvolvimento.
SECRET_KEY=

# "True" para testar no seu computador: páginas de erro detalhadas e qualquer
# endereço aceito. Público. Nunca use "True" num site na internet, porque o
# erro detalhado mostra o código e as configurações a quem visitar.
# Vazio ou "False": modo de produção, que exige o ALLOWED_HOSTS.
DEBUG=True

# --- 2. ENDEREÇO DO SITE ---

# Domínios que o site aceita atender, separados por vírgula (espaços e vírgula
# sobrando são ignorados), por exemplo: seu-dominio.com.br, www.seu-dominio.com.br
# Público. Com DEBUG=True, fica de fora: o site aceita qualquer endereço.
# Vazio com DEBUG=False: o site recusa todo pedido.
ALLOWED_HOSTS=

# Endereço público do site, só esquema e domínio, por exemplo:
# https://seu-dominio.com.br. Público. É de onde saem o canonical, o og:url, o
# /sitemap.xml, a linha Sitemap: do /robots.txt e o endereço absoluto das
# imagens do cartão das redes sociais; nenhum deles usa o Host do pedido, que
# vem do visitante (spec 007). Com caminho, query ou sem http(s)://, o servidor
# não sobe.
# Vazio (padrão): sem canonical e sem sitemap.
URL_PUBLICA=

# Caminho do painel administrativo, por exemplo: painel-secreto/. Público, mas
# trocar o padrão tira o painel do primeiro caminho que os robôs de força bruta
# testam. As barras no início e no fim são opcionais (painel-secreto vale o
# mesmo que /painel-secreto/).
# Vazio ou ausente: o painel fica em admin/.
ADMIN_URL=admin/

# --- 3. E-MAIL DO FORMULÁRIO DE CONTATO (SMTP / GMAIL) ---

# Conta Gmail que envia e recebe as mensagens do formulário de contato, por
# exemplo: seu-email@gmail.com. Público.
# Vazio com DEBUG=True: o e-mail que sairia aparece impresso no terminal do
# runserver, sem precisar de conta Gmail. Vazio em produção: o envio falha e o
# visitante vê o aviso de erro.
EMAIL_USER=

# "Senha de app" de 16 dígitos, gerada na conta Google (não é a sua senha
# comum). Segredo: dá acesso para enviar e-mail pela sua conta.
# Vazio: só funciona junto com o EMAIL_USER vazio (veja acima).
EMAIL_PASS=

# --- 4. DEMONSTRAÇÃO PÚBLICA ---

# "True" numa demonstração aberta ao público (spec 005): o formulário valida os
# campos, mas não grava a mensagem nem envia o e-mail, e avisa o visitante.
# Também troca o título, a description e a imagem do cartão das redes sociais
# pelos da demonstração do template e publica o /.well-known/security.txt com o
# contato de segurança do repositório (spec 007). Público.
# Vazio ou "False" (padrão): fluxo completo, com gravação no banco e envio por
# SMTP.
MODO_DEMONSTRACAO=False

# --- 5. HOSPEDAGEM (spec 006) ---

# Pasta dos dados que o site grava: o banco (db.sqlite3), a mídia enviada pelo
# Admin (media/) e o cache do rate limit (django_cache/). Num servidor em
# contêiner, aponte para o volume que sobrevive ao deploy, por exemplo: /data;
# caminho relativo parte da raiz do projeto. Público.
# Vazio (padrão): a raiz do projeto, como em desenvolvimento.
DIRETORIO_DADOS=
